flowchart TD
    A["Normalized Email\n(from DB)"] --> B{"Layer 1:\nSender Auth\navailable?"}
    B -- "Yes" --> L1["Parse Authentication-Results\nSPF / DKIM / DMARC\nFrom/Return-Path mismatch"]
    B -- "No header" --> SKIP1["Abstain\navailable=False"]
    L1 --> FUS
    SKIP1 --> FUS

    A --> L2["Layer 2:\nURL Heuristics\n(run on all links)"]
    L2 -- "No links" --> SKIP2["Abstain"]
    L2 -- "Links present" --> URLRES["Signal scores:\nIP host, lookalike,\npunycode, mismatch,\nshortener, redirect"]
    URLRES --> FUS
    SKIP2 --> FUS

    A --> L3["Layer 3:\nBERT Classifier\n(bert-finetuned-phishing)"]
    L3 -- "Model cached" --> BERTRES["phishing probability\n(softmax output)"]
    L3 -- "Model missing" --> SKIP3["Abstain"]
    BERTRES --> FUS
    SKIP3 --> FUS

    FUS["Fusion Engine\nRe-normalize weights\nWeighted average\n= F_base"] --> CHK{"Prelim score\n>= 0.25 and\nGemini key set?"}
    CHK -- "Yes" --> L4["Layer 4:\nGemini Social\n4-vector JSON analysis"]
    CHK -- "No" --> RULES
    L4 --> FUS2["Add Layer 4\nto weighted avg"]
    FUS2 --> RULES

    RULES["Apply Rules in order:\n1. Strong-layer floor (0.60)\n2. Threat-intel floor (0.90)\n3. Clean-sender cap\n4. Trust discount (×0.70)"] --> OUT["Write:\nfraud_score\nfraud_label\nlayer_results → DB"]

    style A fill:#f0f0f0,stroke:#888,color:#000
    style OUT fill:#d8d8d8,stroke:#555,color:#000

