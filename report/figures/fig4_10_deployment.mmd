flowchart TD
    subgraph LocalMachine["Local Machine (User's PC)"]
        SRV["FastAPI / Uvicorn\n(HTTP 127.0.0.1:8000)"]
        WRK["Background Worker Thread"]
        DB[("SQLite Database\naegis.db")]
        HF["Hugging Face Model Cache\n(MiniCheck, BERT, MiniLM)"]
        BROWSER["Web Browser"]
    end

    subgraph CloudServices["Cloud Services (HTTPS)"]
        GMAIL["Gmail API\n(api.google.com)"]
        GEMINI["Gemini API\n(generativelanguage.googleapis.com)"]
    end

    BROWSER -- "HTTP loopback" --> SRV
    SRV --> DB
    WRK --> DB
    WRK --> HF
    WRK -- "HTTPS (Gmail read-only)" --> GMAIL
    WRK -- "HTTPS (LLM calls, optional)" --> GEMINI
    SRV -- "HTTPS (OAuth2 token exchange)" --> GMAIL

    style LocalMachine fill:#f5f5f5,stroke:#999,color:#000
    style CloudServices fill:#e8e8e8,stroke:#888,color:#000
    style DB fill:#d0d0d0,stroke:#666,color:#000

